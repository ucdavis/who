# logging
OTEL_EXPORTER_OTLP_ENDPOINT="<otel_endpoint>"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey <apikey>"
OTEL_SERVICE_NAME="<service_name>"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=Development,service.namespace=<service_namespace>"

# Microsoft Entra authentication
# Store the real secret only in server/.env locally or a secure production secret store.
Auth__ClientSecret="<entra_app_client_secret>"

# people lookup
PeopleLookup__IamKey="<iamws_api_key>"
PeopleLookup__SensitiveInfoUsers="<user_email_or_name>,<user_email_or_name>"